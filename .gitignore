# Generated artifacts — never tracked.
workspace/**
!workspace/.gitkeep

# Fingerprint imagery is redistribution-restricted (see docs/adr/0004 and the
# SD300 README: "Users of SD 300 shall adhere to all terms agreed to upon
# obtaining SD 300"). The repository holds instructions and manifests only.
data/**
!data/README.md
*.png
*.pgm
*.wsq

# The exception: tiny synthetic imaging fixtures. Nothing here is a fingerprint —
# they are checkerboards, gradients and ridge-shaped stripes generated by
# tests/fixtures/imaging/generate.py, and their golden hashes are what proves the
# canonical transform still produces the pixels it produced before.
!tests/fixtures/imaging/*.png

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.idea/
.venv/
.env

# Java build output. The bridge is built from source on every machine and in CI;
# a committed 27 MB shaded jar would be a binary nobody could review, and its
# SHA-256 is part of the environment fingerprint precisely so that a locally
# built jar is verifiable rather than trusted.
integrations/*/target/
*.class

# Stage 13A FingerCell bridge build output (links vendor libraries from the
# local artifact store; the binary is a build artifact and never committed).
integrations/fingercell-cpp/build/
